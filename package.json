{
  "name": "bez-tla",
  "productName": "Bez tła",
  "version": "1.0.0",
  "description": "Usuwa tło ze zdjęć produktów, zmniejsza je i zapisuje jako WebP.",
  "homepage": "https://github.com/Skiperpol/bez-tla",
  "desktopName": "bez-tla.desktop",
  "main": "src/main/main.js",
  "author": "Dawid",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --linux AppImage deb",
    "dist:win": "electron-builder --win nsis"
  },
  "build": {
    "appId": "pl.dawid.beztla",
    "productName": "Bez tła",
    "artifactName": "bez-tla-${version}.${ext}",
    "files": [
      "src/**/*",
      "build/icon.png",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/@napi-rs/**",
      "node_modules/onnxruntime-node/**"
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Graphics",
      "icon": "build/icon.png",
      "maintainer": "Dawid",
      "syncDesktopName": true
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    }
  },
  "dependencies": {
    "@napi-rs/image": "^1.15.0",
    "onnxruntime-node": "^1.30.0"
  },
  "devDependencies": {
    "@fontsource-variable/manrope": "^5.3.0",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3"
  }
}
