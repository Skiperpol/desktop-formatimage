{
  "name": "bez-tla",
  "productName": "Bez tła",
  "version": "1.0.0",
  "description": "Usuwa tło ze zdjęć produktów, zmniejsza je i zapisuje jako WebP.",
  "homepage": "https://github.com/Skiperpol/bez-tla",
  "desktopName": "bez-tla.desktop",
  "main": "src/main/main.js",
  "author": "Dawid",
  "private": true,
  "scripts": {
    "start": "electron .",
    "fetch-model": "node scripts/fetch-model.js",
    "dist:win": "npm run fetch-model && electron-builder --win nsis --x64",
    "dist:linux": "npm run fetch-model && electron-builder --linux AppImage"
  },
  "build": {
    "appId": "pl.dawid.beztla",
    "productName": "Bez tła",
    "executableName": "bez-tla",
    "artifactName": "bez-tla-${version}.${ext}",
    "files": [
      "src/**/*",
      "build/icon.png",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/@napi-rs/**",
      "node_modules/onnxruntime-node/**"
    ],
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Graphics",
      "icon": "build/icon.png",
      "maintainer": "Dawid",
      "syncDesktopName": true
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "artifactName": "Bez-tla-Setup-${version}.${ext}"
    },
    "extraResources": [
      {
        "from": "models/birefnet-general-lite.onnx",
        "to": "models/birefnet-general-lite.onnx"
      },
      {
        "from": "THIRD_PARTY_NOTICES.md",
        "to": "THIRD_PARTY_NOTICES.md"
      }
    ],
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Bez tła",
      "uninstallDisplayName": "Bez tła",
      "installerLanguages": [
        "pl_PL"
      ],
      "language": "1045",
      "deleteAppDataOnUninstall": false
    }
  },
  "dependencies": {
    "@napi-rs/image": "^1.15.0",
    "onnxruntime-node": "^1.30.0"
  },
  "devDependencies": {
    "@fontsource-variable/manrope": "^5.3.0",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3"
  },
  "license": "UNLICENSED"
}
